# Optional. Enables Gemini-powered chat and offer analysis.
# Set this in your local .env file and in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional hosting URL for integrations that need the deployed origin.
APP_URL="MY_APP_URL"
VITE_FIREBASE_CONFIG=""

# Optional local profile contact details. Keep real values in .env.local,
# which is excluded from Git.
VITE_PILAR_EMAIL=""
VITE_PILAR_PHONE=""
VITE_PILAR_ADDRESS=""
